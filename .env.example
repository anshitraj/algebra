# Copy to .env and fill in for local development. Never commit a real .env.

# --- Postgres (authoritative commerce state) ---
# Matches docker-compose.yml's default credentials.
DATABASE_URL=postgres://algebra:algebra@localhost:5432/algebra?sslmode=disable

# --- Redis (cache / locks / idempotency fast-path; not authoritative) ---
REDIS_ADDR=localhost:6379

# --- Envelope encryption for PrivacyResolver (internal/domain/privacy) ---
# 32 random bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# In production this should be a KMS-wrapped DEK, not a static env var —
# see docs/GCP_DEPLOYMENT.md. This is a LOCAL-DEV-ONLY secret.
ALGEBRA_MASTER_KEY=

# --- REST API ---
HTTP_ADDR=:8080

# --- OmniClaw policy engine (optional; real, tested integration — see
#     internal/domain/policy/omniclaw_provider.go and BUILD_PLAN.md §1) ---
# Leave both empty to use Algebra's own LocalProvider rule engine (the
# default, and the only provider that understands merchants/categories/INR
# amounts). Set these to route the crypto-payment-source path
# (PaymentSource of type WALLET/STABLECOIN_ACCOUNT) through a real running
# OmniClaw agent server instead.
OMNICLAW_SERVER_URL=http://127.0.0.1:9091
OMNICLAW_TOKEN=

# To actually run OmniClaw locally (vendored at third_party/omniclaw,
# github.com/omnuron/omniclaw):
#
#   cd third_party/omniclaw
#   mkdir -p examples/agent/buyer/runtime
#   cp examples/agent/buyer/policy.example.json examples/agent/buyer/runtime/policy.json
#   # edit runtime/policy.json: replace "replace-with-agent-token" with the
#   # OMNICLAW_AGENT_TOKEN value below (must match OMNICLAW_TOKEN above)
#   docker compose -f examples/agent/buyer/docker-compose.yml --env-file ../../../.env up --build
#
# That compose file needs these (OmniClaw's own vars, not Algebra's —
# uncomment and fill in to actually run it; none of these have real values
# in this environment):
# OMNICLAW_AGENT_TOKEN=            # must match OMNICLAW_TOKEN above
# OMNICLAW_OWNER_TOKEN=            # required for /confirmations approve|deny and privileged withdrawals
# OMNICLAW_BUYER_MODE=hybrid       # or x402 for Gateway-only, no Circle wallet
# OMNICLAW_NETWORK=BASE-SEPOLIA
# OMNICLAW_RPC_URL=                # an EVM RPC endpoint for OMNICLAW_NETWORK
# OMNICLAW_PRIVATE_KEY=            # EOA private key OmniClaw signs payments with (non-custodial: this is the agent's own wallet, Algebra never touches it)
# CIRCLE_API_KEY=                  # only needed for circle_transfer rail / Circle Gateway API helpers
# ENTITY_SECRET=                   # only needed alongside CIRCLE_API_KEY

# --- Approval / quote tuning ---
APPROVAL_TTL=15m
QUOTE_TTL=5m
QUOTE_AMOUNT_TOLERANCE_MINOR_UNITS=500

# --- Webhooks (real endpoint + HMAC verification, no real provider wired
#     up yet — see docs/THREAT_MODEL.md and internal/app/webhook_service.go) ---
# Every inbound POST /api/v1/webhooks/{provider} is REJECTED unless the
# matching secret below is set. Uncomment and fill in only once a real
# provider (a PSP, a merchant) actually sends webhooks here, using
# WHATEVER signature scheme that specific provider uses — the generic
# "sha256=<hmac-hex>" scheme this build implements is a reference default,
# not guaranteed to match a real provider's own format.
# WEBHOOK_SECRET_STRIPE=
# WEBHOOK_SECRET_ZEPTO=

# --- Merchant connectors (docs/MERCHANT_CONNECTORS.md) ---
# Connectors to register. swiggy_instamart is opt-in: Swiggy reviews
# production access to its MCP servers (builders@swiggy.in).
ENABLED_MERCHANTS=mock,zepto,amazon,flipkart,blinkit,generic-browser
# Encrypted linked-account sessions written by cmd/merchant-login.
MERCHANT_SESSION_DIR=.data/merchant-sessions
# Per-merchant budget for discovery (search + cart + quote round trips).
CONNECTOR_TIMEOUT=20s
# Product and handoff links an agent may be given must be on these domains.
MERCHANT_URL_ALLOWLIST=zepto.co.in,zeptonow.com,swiggy.com,amazon.in,flipkart.com,blinkit.com

# Zepto / Swiggy Instamart — official remote MCP servers. No keys go here:
# link an account with `go run ./cmd/merchant-login -merchant zepto` (or
# `-merchant swiggy_instamart -alias shipping:home`). You sign in with your
# phone number and OTP on the merchant's own page; Algebra stores only the
# resulting OAuth tokens, encrypted with ALGEBRA_MASTER_KEY.
ZEPTO_MCP_ENDPOINT=https://mcp.zepto.co.in/mcp
SWIGGY_INSTAMART_MCP_ENDPOINT=https://mcp.swiggy.com/im

# Flipkart — official Affiliate API (catalog search only; no cart/order API exists).
# FLIPKART_AFFILIATE_ID=
# FLIPKART_AFFILIATE_TOKEN=

# Amazon — official Creators API (catalog search only; no cart/order API
# exists). www.amazon.in uses credential version 3.2 (or legacy 2.2).
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# AMAZON_ASSOCIATE_TAG=
# AMAZON_MARKETPLACE=www.amazon.in

# Blinkit — no official API or MCP server exists; handoff links only, nothing to set.

# --- Not yet used in this build (documented for the providers they belong
#     to; wiring them up needs real credentials this environment does not
#     have) ---
# SPREEDLY_ENVIRONMENT_KEY=        # providers/vault SpreedlyProvider
# SPREEDLY_ACCESS_SECRET=
# ARCIUM_CLUSTER_ENDPOINT=         # providers/arcium ArciumProvider
# ARCIUM_PROGRAM_ID=
