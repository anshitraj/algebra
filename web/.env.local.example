# Copy to .env.local for local development. Never commit a real .env.local
# (already covered by .gitignore's .env*). Server-only — no NEXT_PUBLIC_
# prefix, so these never reach the browser bundle. Restart `next dev` after
# editing.

# --- LLM providers for the /console/agent chat (lib/agent/) ---
# Set at least one. A provider with no key is simply hidden from the picker
# (see GET /api/agent/providers) — not a hard error.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model overrides. Defaults live in app/api/agent/chat/route.ts.
# OpenAI has no "latest" alias — bump this if the default goes stale.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-flash-latest

# --- Algebra REST API this console (and the agent's tool calls) talks to ---
NEXT_PUBLIC_API_URL=http://localhost:8080
